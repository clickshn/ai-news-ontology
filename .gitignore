# --- Secrets -------------------------------------------------------------
.env
.env.local
*.pem

# --- 외부 LLM 벤더 호출 1회용 승인 파일 (ADR-017) --------------------------
# 있으면 게이트가 열린다. 커밋되면 "1회용"이 아니게 되므로 반드시 제외한다.
.claude/external-llm-approved

# --- 개인 메모 ------------------------------------------------------------
# CLAUDE.md 는 맥락·판단 근거만 담는 개인 메모다. 따라야 할 규칙은
# docs/governance.md 에 있고 그쪽이 버전 관리 대상이다.
CLAUDE.md

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Virtualenvs ---------------------------------------------------------
venv/
.venv/
env/

# --- Logs & OS -----------------------------------------------------------
*.log
# observability/logs/ 도 여기에 걸린다. 스킵 기록과 미등록 기업 큐는
# 머신별 실행 산출물이라 커밋하지 않는다 (D-036).
logs/
.DS_Store
Thumbs.db

# --- Pipeline artifacts --------------------------------------------------
# eval 실행 결과는 재현 가능한 산출물이므로 커밋하지 않는다.
# 단, 디렉터리 자체는 .gitkeep 으로 유지한다.
eval/scores/*.json
eval/scores/*.jsonl
!.gitkeep

# 수집 원문 / 중간 산출물 (용량이 크고 저작권 이슈가 있을 수 있음)
data/
cache/
