# --- Secrets -------------------------------------------------------------
.env
.env.local
*.pem

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Virtualenvs ---------------------------------------------------------
venv/
.venv/
env/

# --- Logs & OS -----------------------------------------------------------
*.log
# observability/logs/ 도 여기에 걸린다. 스킵 기록과 미등록 기업 큐는
# 머신별 실행 산출물이라 커밋하지 않는다 (D-036).
logs/
.DS_Store
Thumbs.db

# --- Pipeline artifacts --------------------------------------------------
# eval 실행 결과는 재현 가능한 산출물이므로 커밋하지 않는다.
# 단, 디렉터리 자체는 .gitkeep 으로 유지한다.
eval/scores/*.json
eval/scores/*.jsonl
!.gitkeep

# 수집 원문 / 중간 산출물 (용량이 크고 저작권 이슈가 있을 수 있음)
data/
cache/
