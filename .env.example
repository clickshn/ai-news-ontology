# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. (.env 는 커밋되지 않음)
#   cp .env.example .env

# --- LLM (1) 내부 vLLM — 기본이자 유일한 정상 경로 -------------------------
# config.yaml 의 llm.provider 가 "vllm" 이면 여기만 쓴다. (ADR-018)
#
# [중요] **이 URL 자체가 자격증명이다.** 엔드포인트가 인증을 요구하지 않아 주소를
#        아는 사람이 곧 사용할 수 있는 사람이다 (MARA ADR-010). 그래서 코드에도
#        config.yaml 에도 두지 않고 여기로만 주입한다. 이 파일(.env.example)에는
#        플레이스홀더만 커밋한다.
VLLM_BASE=https://your-endpoint/v1
# 비워 두면 gemma-4-31B-it 을 쓴다. 엔드포인트의 /v1/models 가 주는 id 와
# 대소문자까지 같아야 한다.
VLLM_MODEL=

# --- LLM (2) 외부 벤더 — 예외 경로. 기본은 차단이다 ------------------------
# ⛔ 이 레포가 만드는 코퍼스의 소비자(MARA)는 **외부 LLM 벤더 비의존**이 전제다
#    (ADR-017, MARA ADR-021). 아래 키는 config.yaml 의 llm.provider 를
#    "anthropic" 으로 되돌렸을 때만 쓰이고, 그 경우 extraction/egress.py 가
#    `.claude/external-llm-approved` 없이는 클라이언트 생성을 막는다.
#    **키를 채우는 것과 써도 되는 것은 다른 이야기다.**
ANTHROPIC_API_KEY=
LLM_API_KEY=

# identity-linked API 키(조직 계정에 연결된 키)를 쓰는 경우에만 필요하다.
# 비워 두면 헤더를 보내지 않는다. 값이 필요한지는 호출해 보면 알 수 있다 —
# 400 "anthropic-workspace-id is required when authenticating with an
# identity-linked API key" 가 나오면 이 값을 채워야 한다.
# Console > Settings > Workspaces 에서 워크스페이스를 열면 URL 에 있다.
ANTHROPIC_WORKSPACE_ID=

# --- Obsidian ------------------------------------------------------------
# 노트를 적재할 디렉터리의 절대 경로.
# config.yaml 의 output.vault_subdir 이 비어 있지 않으면 그 아래로 내려간다.
# Windows 예: C:\Users\me\Documents\ObsidianVault\AI_News
OBSIDIAN_VAULT_PATH=

# --- Observability (선택) -------------------------------------------------
# Langfuse 로 LLM 호출 trace / eval 점수를 남길 때만 채운다.
# 비어 있으면 observability 레이어는 no-op 으로 동작한다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
